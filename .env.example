# Copy this file to .env and fill in values. The .env file is gitignored.
#
# These are read by docker-compose.yml. Only GITLAB_TOKEN needs to be edited
# after the bootstrap step; GITLAB_URL inside the compose network is fixed
# to http://gitlab and is set on the api service directly.

# Personal access token for the GitLab instance.
# For the local playground: leave blank, then run
#   docker compose up -d gitlab
#   ./scripts/bootstrap-playground.sh
# and paste the GITLAB_TOKEN=... line it prints over the line below.
GITLAB_TOKEN=

LOG_LEVEL=INFO
